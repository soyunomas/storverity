<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>StorVerity</vendor>
  <vendor_url>https://github.com/soyunomas/storverity</vendor_url>
  <action id="io.github.soyunomas.StorVerity.raw-probe">
    <description>Run a destructive StorVerity raw capacity probe</description>
    <message>Authentication is required to test this storage device with raw writes</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
</policyconfig>
